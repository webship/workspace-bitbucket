{
  "name": "@webship.co/workspace-bitbucket",
  "version": "1.0.9",
  "description": "Bitbucket for Webship Workspace: the BITBUCKET menu on every project whose remote is on bitbucket.org (repository, issues, pull requests, the New-pull-request page for the branch), the repository chip, clone when a new folder is made, and the credential the dashboard uses there. It carries its AI items, each placed in the workspace folder of its kind: an agent, a skill, a command and a prompt. A provider of @webship.co/workspace-forge.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-bitbucket.git"
  },
  "files": [
    "dist/src",
    "ai",
    "config",
    "features",
    "scripts",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "bitbucket",
    "label": "Bitbucket",
    "needs": [
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "settingsFile": "plugin.bitbucket.settings.yml",
    "settingsTemplate": "config/plugin.bitbucket.settings.yml",
    "labels": "config/settings.labels.yml",
    "legacySettingsKey": "git.bitbucket",
    "scripts": {
      "hostInstall": "scripts/host-install.sh"
    },
    "ai": {
      "agents": [
        "ai/agents/bitbucket-pr-preparer.md"
      ],
      "skills": [
        "ai/skills/bitbucket-forge"
      ],
      "commands": [
        "ai/commands/bitbucket-status.md"
      ],
      "prompts": [
        "ai/prompts/bitbucket-branch-to-pr.md"
      ]
    },
    "features": [
      "features/bitbucket.feature"
    ]
  },
  "dependencies": {
    "@webship.co/workspace-forge": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
